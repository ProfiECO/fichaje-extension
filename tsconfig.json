{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["chrome", "node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "extension", "vite.config.ts", "tests"]
}
