{
  "manifest_version": 3,
  "name": "Fichaje Frappe HR",
  "version": "0.2.0",
  "description": "Fichaje en Frappe HR, objetivos e historial semanal.",
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Fichaje"
  },
  "permissions": [
    "storage",
    "geolocation"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
